FROM dunglas/frankenphp:1-php8.4-alpine

WORKDIR /app

# Node sert au serveur Vite (service `vite`) : le plugin Wayfinder y appelle
# `php artisan`, d'où une seule image PHP + Node pour tous les services.
RUN apk add --no-cache nodejs npm \
    && install-php-extensions pdo_pgsql pcntl opcache zip redis intl xdebug

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Xdebug est installé mais désactivé par défaut (coûteux avec Octane/Horizon).
# Pour l'activer : XDEBUG_MODE=debug docker compose up -d app
ENV XDEBUG_MODE=off \
    XDEBUG_CONFIG="client_host=host.docker.internal start_with_request=trigger"

# Les dépendances sont installées dans l'image pour peupler les volumes nommés
# vendor/ et node_modules/ à leur création (voir docker-compose.yml).
COPY composer.json composer.lock ./
# (s) veut dire ne rien copier si le dossier app-module n'existe pas (utile pour le premier setup)
COPY app-module[s] ./app-modules
RUN composer install --no-scripts --no-interaction

COPY package.json package-lock.json .npmrc ./
RUN npm ci --no-audit --no-fund

COPY . .

COPY docker/dev-entrypoint.sh /usr/local/bin/dev-entrypoint
RUN chmod +x /usr/local/bin/dev-entrypoint

ENV SERVER_NAME=":8080"
ENV APP_ENV=local
EXPOSE 8080

ENTRYPOINT ["dev-entrypoint"]
CMD ["php", "artisan", "octane:frankenphp", "--host=0.0.0.0", "--port=8080", "--watch"]
